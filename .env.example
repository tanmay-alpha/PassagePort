# PassagePort configuration.
#
# Copy to `.env` (repository root). It is read by `docker compose`, by `scripts/dev.sh` /
# `scripts/dev.ps1` and by `make backend`. Every line below is commented out, so an empty `.env`
# is a working local setup. Lines show the built-in default; settings that are unset by default
# show an example value instead. An empty value counts as unset. Lists are JSON arrays.
# Never commit your `.env`.

# ----------------------------------------------------------------------------- storage
# Directory for the SQLite database and uploaded files. Relative paths are resolved from
# backend/ in development. (Docker: fixed to /data, a volume.)
#PP_DATA_DIR=./data
# Database URL. Unset = SQLite file inside PP_DATA_DIR. The postgres:// and postgresql:// URLs
# issued by hosting providers are accepted as-is.
#PP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Where original uploads are kept: fs (PP_DATA_DIR/blobs) or db (in the database, for hosts
# without a persistent disk).
#PP_BLOB_BACKEND=fs

# ----------------------------------------------------------------------------- access control
# local    = no login; one implicit user; only requests with a loopback Host header are served.
#            Safe on your own machine, NOT safe to expose to a network.
# accounts = username/password accounts, cookie sessions, per-user isolation, API tokens.
#            Required before PassagePort is reachable by anyone else.
#PP_AUTH_MODE=local
# Host names accepted in local mode.
#PP_LOCAL_ALLOWED_HOSTS='["localhost","127.0.0.1","[::1]"]'

# --- accounts mode only ---
# Allow new accounts to be created from the sign-in page.
#PP_ALLOW_SIGNUP=true
# If set, signing up requires this code. Recommended on any public deployment.
#PP_SIGNUP_CODE=choose-a-long-random-code
# Offer "continue as guest": throw-away accounts deleted after PP_GUEST_TTL_HOURS.
#PP_ALLOW_GUESTS=false
#PP_GUEST_TTL_HOURS=24
# Session lifetime (default 14 days).
#PP_SESSION_TTL_HOURS=336
# Session cookies are sent over HTTPS only. Set to false ONLY to try accounts mode over
# plain http:// on a private network.
#PP_COOKIE_SECURE=true
# Origins allowed to call the API cross-origin. Not needed when the backend serves the web
# client itself (the default in Docker and in `make dev` via the Vite proxy).
#PP_CORS_ORIGINS='[]'

# ----------------------------------------------------------------------------- limits
# Per uploaded file.
#PP_MAX_UPLOAD_MB=25
#PP_MAX_PAGES=1500
#PP_MAX_DOCUMENT_CHARS=4000000
# Per user.
#PP_MAX_COLLECTIONS_PER_USER=100
#PP_MAX_DOCUMENTS_PER_USER=300
#PP_MAX_STORAGE_MB_PER_USER=500
#PP_MAX_QUERY_CHARS=1000
# Search / ask / compare / lab requests per user per minute. 0 disables the limit.
#PP_RATE_LIMIT_PER_MINUTE=120
# Parsing runs in a subprocess that is killed after this many seconds.
#PP_PARSE_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------- models
# fastembed             = ONNX Runtime, no PyTorch (default).
# sentence-transformers = PyTorch models; needs `uv sync --extra heavy`. Use it for
#                         multilingual models such as Alibaba-NLP/gte-multilingual-base.
# hashing               = deterministic test embedder, no download, no real semantics.
#PP_EMBEDDING_BACKEND=fastembed
#PP_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# fastembed | sentence-transformers | none (skip the cross-encoder reranking stage).
#PP_RERANKER_BACKEND=fastembed
#PP_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Where model files are cached. Unset = the library's default cache. (Docker: fixed to /models.)
#PP_MODEL_CACHE_DIR=./models
#PP_EMBED_BATCH_SIZE=32
# Changing the embedding model or the chunking settings marks existing documents as stale;
# re-index them from the UI to make them searchable semantically again.

# ----------------------------------------------------------------------------- chunking
#PP_CHUNK_MAX_TOKENS=256
#PP_CHUNK_OVERLAP_TOKENS=0

# ----------------------------------------------------------------------------- retrieval defaults
# These are the server defaults; Search Lab can override them per request.
#PP_SEARCH_TOP_K=8
# Candidates taken from each retriever (keyword, semantic) before fusion.
#PP_SEARCH_CANDIDATES=30
# Reciprocal-rank-fusion constant and per-retriever weights.
#PP_RRF_K=60
#PP_LEXICAL_WEIGHT=1.0
#PP_VECTOR_WEIGHT=1.0
#PP_RERANK_BY_DEFAULT=true
#PP_RERANK_CANDIDATES=20
#PP_BM25_K1=1.2
#PP_BM25_B=0.75
# Evidence below these thresholds is reported as low-confidence / insufficient.
#PP_MIN_VECTOR_SIMILARITY=0.35
#PP_MIN_RERANK_SCORE=0.0

# ----------------------------------------------------------------------------- optional LLM
# Any OpenAI-compatible chat-completions endpoint. Leave PP_LLM_BASE_URL and PP_LLM_MODEL unset
# to run without an LLM: Ask then returns extractive answers (verbatim sentences with
# citations) and Compare returns the computed alignment only.
# With an LLM configured, the question and the retrieved passages are sent to that provider.
#
#   OpenAI:  PP_LLM_BASE_URL=https://api.openai.com/v1        PP_LLM_MODEL=<a chat model id>
#   Groq:    PP_LLM_BASE_URL=https://api.groq.com/openai/v1   PP_LLM_MODEL=<a chat model id>
#   Ollama:  PP_LLM_BASE_URL=http://localhost:11434/v1        PP_LLM_MODEL=<a pulled model>
#            (no key needed; from Docker use http://host.docker.internal:11434/v1)
#PP_LLM_BASE_URL=https://api.openai.com/v1
#PP_LLM_API_KEY=your-api-key
#PP_LLM_MODEL=a-chat-model-id
#PP_LLM_TIMEOUT_SECONDS=60
# Maximum number of passages sent to the LLM as evidence.
#PP_LLM_MAX_EVIDENCE=6

# ----------------------------------------------------------------------------- background jobs
# thread = indexing runs in a worker thread inside the server process.
# manual = nothing runs until triggered in code (used by the test-suite).
#PP_JOB_MODE=thread
# A job whose lease expires (crashed worker) is picked up again.
#PP_JOB_LEASE_SECONDS=60
#PP_JOB_MAX_ATTEMPTS=2

# ----------------------------------------------------------------------------- server
#PP_LOG_LEVEL=INFO
# Directory with the built web client. Unset = API only. (Docker: fixed to /app/static.)
#PP_STATIC_DIR=../frontend/dist
# Evaluation report shown in Search Lab. Unset = the report bundled with the backend.
#PP_EVAL_REPORT_PATH=/path/to/report.json

# ----------------------------------------------------------------------------- Docker only
# Port inside the container (platforms such as Render or Fly set this themselves).
#PORT=8000
# Host port published by docker compose, always on 127.0.0.1.
#PASSAGEPORT_PORT=8000
# 1 = bake the default models into the image at build time; 0 = download on first use.
#PRELOAD_MODELS=1
# Addresses whose X-Forwarded-* headers uvicorn trusts. Set to your reverse proxy's address.
#FORWARDED_ALLOW_IPS=127.0.0.1
# Password of the optional `postgres` compose profile.
#POSTGRES_PASSWORD=choose-a-password
