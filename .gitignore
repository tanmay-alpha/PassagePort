# Every rule is anchored or names a tool-generated directory, so no source directory
# (docs/, samples/, eval/datasets, eval/results, frontend/src/**) can be ignored by accident.

# --- secrets / local configuration ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
/backend/.venv*/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
/backend/dist/
/backend/build/

# --- Node ---
node_modules/
*.tsbuildinfo
npm-debug.log*
/frontend/dist/
/frontend/coverage/
/mcp-server/dist/
/mcp-server/coverage/

# --- Playwright ---
/e2e/playwright-report/
/e2e/test-results/
/e2e/blob-report/
/e2e/.auth/

# --- runtime data (database, uploaded files, downloaded models) ---
/backend/data/
/data/
/models/
/.model-cache/

# --- evaluation: downloaded corpora are cached, datasets and results are committed ---
/eval/.cache/

# --- deployment / tooling ---
.vercel/
*.log

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
